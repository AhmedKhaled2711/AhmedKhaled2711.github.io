---
import { personalInfo } from '../../data/portfolio';

const navItems = [
  { label: 'About', href: '/#about' },
  { label: 'Hatli', href: '/#hatli', isFeatured: true },
  { label: 'Projects', href: '/#projects' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Skills', href: '/#skills' },
  { label: 'Contact', href: '/#contact' },
];
---

<header class="site-header" id="site-header">
  <div class="container header-container">
    <a href="/" class="brand" aria-label="Ahmed Khaled, Native Android Engineer - Home">
      <div class="brand-monogram">
        <span class="monogram-text">AK</span>
        <span class="android-indicator" aria-hidden="true"></span>
      </div>
      <div class="brand-meta">
        <span class="brand-name">Ahmed Khaled</span>
        <span class="brand-title">Native Android Engineer</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="desktop-nav" aria-label="Main Navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class={`nav-link ${item.isFeatured ? 'featured-link' : ''}`}>
              {item.isFeatured && <span class="nav-sparkle" aria-hidden="true">●</span>}
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <!-- Theme Switcher -->
      <button
        id="theme-toggle"
        class="theme-btn"
        type="button"
        aria-label="Switch color theme"
        title="Toggle color theme"
      >
        <svg class="sun-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2"></path>
          <path d="M12 20v2"></path>
          <path d="m4.93 4.93 1.41 1.41"></path>
          <path d="m17.66 17.66 1.41 1.41"></path>
          <path d="M2 12h2"></path>
          <path d="M20 12h2"></path>
          <path d="m6.34 17.66-1.41 1.41"></path>
          <path d="m19.07 4.93-1.41 1.41"></path>
        </svg>
        <svg class="moon-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
        </svg>
      </button>

      <!-- CV Download Action (Desktop & Tablet) -->
      <a href={personalInfo.resumeUrl} download="Ahmed_Khaled_Android_Engineer.pdf" class="btn btn-sm btn-cv header-cv-btn" aria-label="Download Ahmed Khaled's CV (PDF)">
        <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" y1="15" x2="12" y2="3"></line>
        </svg>
        <span>CV</span>
      </a>

      <!-- Mobile Menu Toggle Button (Min 44x44px target) -->
      <button
        id="mobile-menu-toggle"
        class="mobile-toggle-btn"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Backdrop Overlay -->
  <div id="mobile-nav-backdrop" class="mobile-nav-backdrop" aria-hidden="true"></div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav" class="mobile-nav" aria-label="Mobile Navigation" hidden>
    <div class="mobile-nav-inner">
      <ul class="mobile-nav-list">
        {navItems.map((item) => (
          <li>
            <a href={item.href} class="mobile-nav-link">
              <span>{item.label}</span>
              {item.isFeatured && <span class="mobile-featured-pill">Flagship</span>}
            </a>
          </li>
        ))}
      </ul>

      <!-- Mobile Menu Actions -->
      <div class="mobile-actions-wrapper">
        <a
          href={personalInfo.social.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp mobile-action-btn"
          aria-label="Chat with Ahmed Khaled on WhatsApp (opens in new tab)"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.301-.15-1.78-.878-2.056-.978-.276-.1-.476-.15-.677.15-.2.301-.777.978-.953 1.18-.175.201-.351.226-.652.075-.301-.151-1.27-.468-2.42-1.493-.895-.798-1.5-1.784-1.676-2.085-.175-.301-.019-.464.132-.614.135-.135.301-.351.451-.527.151-.176.201-.301.301-.502.1-.201.05-.376-.025-.527-.075-.15-.677-1.631-.928-2.233-.245-.586-.494-.506-.677-.515-.176-.009-.376-.011-.577-.011s-.527.075-.803.376c-.276.301-1.053 1.029-1.053 2.509 0 1.48 1.079 2.909 1.229 3.11.151.201 2.123 3.242 5.143 4.547.718.31 1.279.496 1.716.635.722.23 1.378.197 1.898.12.579-.087 1.78-.728 2.031-1.431.251-.703.251-1.305.176-1.431-.075-.126-.276-.201-.577-.351zM12.042 21.846h-.008a9.838 9.838 0 0 1-5.01-1.376l-.36-.214-3.725.977.994-3.632-.234-.373a9.834 9.834 0 0 1-1.51-5.26c.003-5.434 4.423-9.854 9.86-9.854 2.632.001 5.106 1.026 6.967 2.888a9.805 9.805 0 0 1 2.885 6.964c-.004 5.435-4.424 9.855-9.859 9.855zm8.413-18.27A11.83 11.83 0 0 0 12.042 0C5.402 0 .01 5.393.007 12.034a11.82 11.82 0 0 0 1.815 6.273L0 24l5.856-1.536a11.854 11.854 0 0 0 6.183 1.734h.005c6.638 0 12.031-5.393 12.035-12.035a11.815 11.815 0 0 0-3.624-8.617z"/>
          </svg>
          <span>Chat on WhatsApp</span>
        </a>

        <a href={personalInfo.resumeUrl} download="Ahmed_Khaled_Android_Engineer.pdf" class="btn btn-secondary mobile-action-btn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Complete CV (PDF)</span>
        </a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: var(--bg-nav);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  /* Brand Styling */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text-primary);
    min-height: 44px;
    flex-shrink: 0;
  }

  .brand-monogram {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text-primary);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
    flex-shrink: 0;
  }

  .brand:hover .brand-monogram {
    border-color: var(--accent);
    transform: scale(1.04);
  }

  .android-indicator {
    position: absolute;
    top: -2px;
    right: -2px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .brand-meta {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-weight: 700;
    font-size: clamp(0.9rem, 2.5vw, 1rem);
    letter-spacing: -0.015em;
    line-height: 1.2;
    white-space: nowrap;
  }

  .brand-title {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  @media (max-width: 520px) {
    .brand-title {
      display: none;
    }
  }

  /* Desktop Nav */
  .desktop-nav {
    display: none;
  }

  @media (min-width: 860px) {
    .desktop-nav {
      display: block;
    }
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    list-style: none;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    padding: 0.5rem 0.25rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
  }

  .nav-link:hover {
    color: var(--accent);
  }

  .featured-link {
    color: var(--text-primary);
    font-weight: 600;
  }

  .nav-sparkle {
    font-size: 0.5rem;
    color: var(--accent);
  }

  /* Actions */
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }

  .theme-btn {
    min-width: 44px;
    min-height: 44px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all var(--transition-fast);
    cursor: pointer;
    flex-shrink: 0;
  }

  .theme-btn:hover {
    color: var(--accent);
    border-color: var(--border-medium);
  }

  :global([data-theme="dark"]) .sun-icon {
    display: block;
  }
  :global([data-theme="dark"]) .moon-icon {
    display: none;
  }

  :global(:not([data-theme="dark"])) .sun-icon {
    display: none;
  }
  :global(:not([data-theme="dark"])) .moon-icon {
    display: block;
  }

  .header-cv-btn {
    display: none;
    min-height: 44px;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-medium);
    color: var(--text-primary);
    font-weight: 600;
    padding: 0.45rem 0.85rem;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .header-cv-btn {
      display: inline-flex;
    }
  }

  .header-cv-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Mobile Toggle (Min 44x44px target) */
  .mobile-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    min-width: 44px;
    min-height: 44px;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    padding: 10px;
    cursor: pointer;
    flex-shrink: 0;
  }

  @media (min-width: 860px) {
    .mobile-toggle-btn {
      display: none;
    }
  }

  .hamburger-bar {
    width: 20px;
    height: 2px;
    background-color: var(--text-primary);
    border-radius: 2px;
    transition: transform var(--transition-normal), opacity var(--transition-normal);
  }

  .mobile-toggle-btn[aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle-btn[aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle-btn[aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile Backdrop Overlay */
  .mobile-nav-backdrop {
    display: none;
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 98;
    opacity: 0;
    transition: opacity var(--transition-normal);
  }

  .mobile-nav-backdrop.is-active {
    display: block;
    opacity: 1;
  }

  @media (min-width: 860px) {
    .mobile-nav-backdrop {
      display: none !important;
    }
  }

  /* Mobile Nav Drawer */
  .mobile-nav {
    display: block;
    position: fixed;
    top: var(--header-height);
    left: 0;
    right: 0;
    bottom: 0;
    height: calc(100dvh - var(--header-height));
    max-height: calc(100dvh - var(--header-height));
    background-color: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    z-index: 99;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: var(--shadow-xl);
    transform: translateY(-8px);
    opacity: 0;
    visibility: hidden;
    transition: transform var(--transition-normal), opacity var(--transition-normal), visibility var(--transition-normal);
  }

  .mobile-nav.is-open {
    transform: translateY(0);
    opacity: 1;
    visibility: visible;
  }

  @media (min-width: 860px) {
    .mobile-nav {
      display: none !important;
    }
  }

  .mobile-nav-inner {
    max-width: var(--max-width-site);
    margin: 0 auto;
    padding: 1.5rem clamp(1rem, 4vw, 2rem) 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 100%;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    padding: 0.75rem 0.5rem;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .mobile-nav-link:hover,
  .mobile-nav-link:focus-visible {
    background-color: var(--bg-surface-elevated);
    color: var(--accent);
  }

  .mobile-featured-pill {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-full);
    background-color: var(--accent-light);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .mobile-actions-wrapper {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mobile-action-btn {
    width: 100%;
    min-height: 48px;
    justify-content: center;
  }
</style>

<script>
  // Mobile Nav Drawer Toggle & Keyboard Handling
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const backdrop = document.getElementById('mobile-nav-backdrop');

  function closeMobileNav() {
    if (toggleBtn && mobileNav) {
      toggleBtn.setAttribute('aria-expanded', 'false');
      toggleBtn.setAttribute('aria-label', 'Open navigation menu');
      mobileNav.classList.remove('is-open');
      mobileNav.setAttribute('hidden', '');
      if (backdrop) {
        backdrop.classList.remove('is-active');
      }
      document.body.classList.remove('nav-open');
    }
  }

  function openMobileNav() {
    if (toggleBtn && mobileNav) {
      toggleBtn.setAttribute('aria-expanded', 'true');
      toggleBtn.setAttribute('aria-label', 'Close navigation menu');
      mobileNav.removeAttribute('hidden');
      // trigger reflow for smooth transition
      void mobileNav.offsetHeight;
      mobileNav.classList.add('is-open');
      if (backdrop) {
        backdrop.classList.add('is-active');
      }
      document.body.classList.add('nav-open');
    }
  }

  if (toggleBtn && mobileNav) {
    toggleBtn.addEventListener('click', () => {
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        closeMobileNav();
      } else {
        openMobileNav();
      }
    });

    if (backdrop) {
      backdrop.addEventListener('click', () => {
        closeMobileNav();
      });
    }

    // Close when clicking any nav link
    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        closeMobileNav();
      });
    });

    // Close on Escape key and restore focus
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMobileNav();
        toggleBtn.focus();
      }
    });

    // Close mobile nav automatically if window expands past mobile breakpoint
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 860 && toggleBtn.getAttribute('aria-expanded') === 'true') {
        closeMobileNav();
      }
    });
  }

  // Theme Toggle Logic with accessible labels
  const themeToggle = document.getElementById('theme-toggle');
  function updateThemeLabel(theme: string) {
    if (themeToggle) {
      const nextTheme = theme === 'dark' ? 'light' : 'dark';
      themeToggle.setAttribute('aria-label', `Switch to ${nextTheme} theme`);
      themeToggle.setAttribute('title', `Switch to ${nextTheme} theme`);
    }
  }

  if (themeToggle) {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    updateThemeLabel(currentTheme);

    themeToggle.addEventListener('click', () => {
      const activeTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      const newTheme = activeTheme === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', newTheme);
      localStorage.setItem('theme', newTheme);
      updateThemeLabel(newTheme);
    });
  }
</script>
