---
import SectionHeading from '../ui/SectionHeading.astro';

const factualHighlights = [
  {
    title: 'Multi-Module Production Releases',
    description: 'Direct contribution to shipping and maintaining production applications deployed across Client, Delivery, and Store systems.',
  },
  {
    title: 'Cross-Domain Experience',
    description: 'Hands-on development spanning hyperlocal on-demand delivery, multi-service transportation platforms, and e-commerce ecosystems.',
  },
  {
    title: 'Architecture & Stability Discipline',
    description: 'Rigorous implementation of MVVM and Clean Architecture with proactive crash triage via Crashlytics and startup optimization.',
  },
  {
    title: 'Team Coordination & Ownership',
    description: 'Led squads during intensive ITI graduation and Java development projects, coordinating tasks, code reviews, and releases.',
  },
];
---

<section class="section-padding about-section" id="about">
  <div class="container">
    <SectionHeading
      eyebrow="Engineering Overview"
      title="Architecture-Minded Android Engineering"
      subtitle="Focusing on maintainable modular architectures, deterministic asynchronous state, and high-reliability user experiences for commercial mobile products."
    />

    <div class="about-grid">
      <div class="about-narrative">
        <p class="about-text">
          I am a <strong>Native Android Engineer</strong> with 2+ years of professional experience engineering applications that support real-world commercial operations. My work centers on the belief that mobile engineering is not merely about assembling UI screens—it is about designing resilient systems where asynchronous state, network boundaries, and local persistence interact predictably.
        </p>

        <p class="about-text">
          Currently based in <strong>Cairo, Egypt</strong> (military status: <em>Exempted</em>), I contribute to production applications serving high-velocity delivery platforms. My background combines deep computer science fundamentals from <strong>Menofia University</strong> with intensive 9-month professional post-graduate engineering from the <strong>Information Technology Institute (ITI - MCIT)</strong>.
        </p>

        <p class="about-text">
          Whether restructuring legacy code into modular Kotlin Coroutine flows, implementing offline-first caching via Room, or designing bidirectional (RTL) Arabic interfaces with Jetpack Compose, my focus remains consistent: <strong>code clarity, runtime performance, and zero regressions</strong>.
        </p>

        <div class="about-meta-row">
          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">Cairo, Egypt</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Work Authorization</span>
            <span class="meta-value">Exempted (Full Availability)</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Languages</span>
            <span class="meta-value">Arabic (Native) • English (Excellent)</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Target Roles</span>
            <span class="meta-value">Android Engineer (Mid-Level)</span>
          </div>
        </div>
      </div>

      <div class="about-highlights-col">
        <h3 class="highlights-heading">Documented Competencies</h3>
        <div class="highlights-stack">
          {factualHighlights.map((item, index) => (
            <div class="highlight-box">
              <div class="box-number">0{index + 1}</div>
              <div class="box-content">
                <h4 class="box-title">{item.title}</h4>
                <p class="box-desc">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 4rem;
    }
  }

  .about-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-text {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-text strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-text em {
    font-style: normal;
    color: var(--accent);
    font-weight: 500;
  }

  .about-meta-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 1.25rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  @media (min-width: 540px) {
    .about-meta-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .meta-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Highlights Column */
  .about-highlights-col {
    display: flex;
    flex-direction: column;
  }

  .highlights-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .highlights-heading::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 16px;
    background-color: var(--accent);
    border-radius: 2px;
  }

  .highlights-stack {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .highlight-box {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .highlight-box:hover {
    border-color: var(--border-medium);
    transform: translateX(3px);
  }

  .box-number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
  }

  .box-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .box-desc {
    margin-top: 0.35rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
</style>
