---
import SectionHeading from '../ui/SectionHeading.astro';

const factualHighlights = [
  {
    title: 'Multi-Module Production Releases',
    description: 'Direct contribution to shipping and maintaining production apps across Client, Delivery, and Store platforms.',
  },
  {
    title: 'Cross-Domain Commercial Experience',
    description: 'Hands-on development spanning on-demand food delivery, multi-service transport (Dorr), and e-commerce.',
  },
  {
    title: 'Architecture & Stability Focus',
    description: 'Implementation of Clean Architecture and MVVM with proactive Crashlytics triage and startup optimization.',
  },
  {
    title: 'Leadership & Team Ownership',
    description: 'Led squads during intensive ITI graduation and Java development projects, coordinating reviews and releases.',
  },
];
---

<section class="section-padding about-section" id="about">
  <div class="container">
    <SectionHeading
      eyebrow="Engineering Overview"
      title="Architecture-Minded Android Engineering"
      subtitle="Designing resilient mobile systems where asynchronous state, network boundaries, and local persistence interact predictably."
    />

    <div class="about-grid">
      <div class="about-narrative">
        <p class="about-text">
          I engineer production Android applications with an emphasis on <strong>modular Clean Architecture</strong>, <strong>reactive concurrency</strong>, and <strong>offline-first resilience</strong>. My commercial experience spans multi-module food delivery platforms, high-traffic transportation ecosystems, and e-commerce products serving active user bases across Egypt and the GCC.
        </p>

        <p class="about-text">
          Combining computer science foundations from <strong>Menofia University</strong> with 9-month professional post-graduate training from the <strong>Information Technology Institute (ITI - MCIT)</strong>, I focus on building maintainable codebases with Kotlin Coroutines/Flow, robust Room caching, and native Arabic (RTL) UI excellence.
        </p>

        <div class="about-meta-row" aria-label="Professional Details">
          <div class="meta-item">
            <span class="meta-label">Location</span>
            <span class="meta-value">Cairo, Egypt</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Military Status</span>
            <span class="meta-value">Exempted (Full Availability)</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Languages</span>
            <span class="meta-value">Arabic (Native) • English (Working)</span>
          </div>
          <div class="meta-item">
            <span class="meta-label">Core Target</span>
            <span class="meta-value">Android Engineer (Mid-Level)</span>
          </div>
        </div>
      </div>

      <div class="about-highlights-col">
        <h3 class="highlights-heading">Documented Highlights</h3>
        <div class="highlights-stack">
          {factualHighlights.map((item, index) => (
            <div class="highlight-box">
              <div class="box-number" aria-hidden="true">0{index + 1}</div>
              <div class="box-content">
                <h4 class="box-title">{item.title}</h4>
                <p class="box-desc">{item.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    background-color: var(--bg-surface);
    border-bottom: 1px solid var(--border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .about-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 3.5rem;
    }
  }

  .about-narrative {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-text {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .about-text strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .about-meta-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    margin-top: 1rem;
    padding: 1.25rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  @media (min-width: 480px) {
    .about-meta-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }

  .meta-value {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* Highlights Column */
  .about-highlights-col {
    display: flex;
    flex-direction: column;
  }

  .highlights-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .highlights-heading::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 16px;
    background-color: var(--accent);
    border-radius: 2px;
  }

  .highlights-stack {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .highlight-box {
    display: flex;
    gap: 0.875rem;
    padding: 1.125rem;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: all var(--transition-fast);
  }

  .highlight-box:hover {
    border-color: var(--border-medium);
    transform: translateX(3px);
  }

  .box-number {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
    flex-shrink: 0;
  }

  .box-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.35;
  }

  .box-desc {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
