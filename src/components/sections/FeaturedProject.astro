---
import SectionHeading from '../ui/SectionHeading.astro';
import TechnologyBadge from '../ui/TechnologyBadge.astro';
import { hatliProject } from '../../data/portfolio';
---

<section class="section-padding hatli-flagship-section" id="hatli">
  <div class="container">
    <SectionHeading
      eyebrow="Flagship Android Project"
      title="Hatli — هاتلي"
      subtitle={hatliProject.tagline}
    />

    <!-- Flagship Showcase Card -->
    <div class="hatli-card">
      <!-- Header Banner -->
      <div class="hatli-card-header">
        <div class="hatli-brand-row">
          <div class="hatli-logo-wrapper">
            <img src={hatliProject.images.logo} alt="Hatli Brand Logo" width="48" height="48" class="hatli-logo-img" />
          </div>
          <div>
            <div class="badge-row">
              <span class="badge badge-accent">
                <span class="dot-live" aria-hidden="true"></span>
                {hatliProject.badge}
              </span>
              <span class="badge badge-mono">Kotlin 2.0 • Compose BOM 2025</span>
            </div>
            <h3 class="hatli-main-title">{hatliProject.titleEn} <span class="ar-title">({hatliProject.titleAr})</span></h3>
          </div>
        </div>

        <p class="hatli-summary-text">{hatliProject.summary}</p>

        <!-- CTA Action Buttons -->
        <div class="hatli-action-row">
          <a href="/projects/hatli" class="btn btn-primary">
            <span>Read Technical Case Study</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href={hatliProject.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary" aria-label="View Hatli source code on GitHub (opens in new tab)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
            <span>GitHub Repository</span>
          </a>
          {hatliProject.videoUrl && (
            <a href={hatliProject.videoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary video-walkthrough-btn" aria-label="Watch Hatli video walkthrough on YouTube (opens in new tab)">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" color="#EF4444" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>Watch Video Walkthrough</span>
            </a>
          )}
        </div>

        <!-- Tech Stack Badges -->
        <div class="hatli-tags-row" aria-label="Hatli technology stack">
          {hatliProject.techStack.map((tech) => (
            <TechnologyBadge name={tech} variant="default" size="sm" />
          ))}
        </div>
      </div>

      <!-- Authentic Device Mockup Showcase -->
      <div class="hatli-visual-stage">
        <div class="mockup-frame">
          <img
            src={hatliProject.images.mockup}
            alt="Hatli Native Android App UI showcase featuring mobile screens on physical devices"
            class="mockup-img"
            loading="eager"
            width="1200"
            height="675"
          />
        </div>
        <div class="mockup-caption-bar">
          <span class="caption-tag">Production UI Highlights</span>
          <p class="caption-text">
            3-step errand wizard • 5-stage real-time lifecycle tracking • Live in-app chat • Landmark-first delivery drop-offs
          </p>
        </div>
      </div>

      <!-- Problem vs Solution Comparison -->
      <div class="problem-solution-grid">
        <div class="ps-card problem-card">
          <div class="ps-header">
            <span class="ps-icon" aria-hidden="true">⚠️</span>
            <h4 class="ps-title">Emerging Market Problem</h4>
          </div>
          <p class="ps-body">{hatliProject.problem}</p>
        </div>

        <div class="ps-card solution-card">
          <div class="ps-header">
            <span class="ps-icon" aria-hidden="true">💡</span>
            <h4 class="ps-title">The Hatli Solution</h4>
          </div>
          <p class="ps-body">{hatliProject.solution}</p>
        </div>
      </div>

      <!-- Core Architectural Highlights Grid -->
      <div class="highlights-container">
        <div class="highlights-header">
          <h4 class="highlights-title">Core Engineering Decisions</h4>
          <span class="highlights-badge">Production Architecture</span>
        </div>

        <div class="highlights-grid">
          {hatliProject.deepDives.map((dive, idx) => (
            <div class="highlight-item-card">
              <div class="item-card-top">
                <span class="item-num" aria-hidden="true">0{idx + 1}</span>
                <div>
                  <h5 class="item-title">{dive.title}</h5>
                  <span class="item-sub">{dive.subtitle}</span>
                </div>
              </div>
              <p class="item-desc">{dive.problem}</p>
              <div class="item-impact">
                <span class="impact-label">Architectural Solution:</span>
                <p class="impact-text">{dive.whyItMatters}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Bottom Case Study Action Banner -->
      <div class="hatli-footer-banner">
        <div>
          <h4 class="banner-title">Inspect the full 12-module Clean Architecture</h4>
          <p class="banner-sub">Review the module dependency graph, Firestore schema mappers, and implementation matrix.</p>
        </div>
        <a href="/projects/hatli" class="btn btn-primary">
          <span>Explore Dedicated Case Study →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hatli-flagship-section {
    background-color: var(--bg-canvas);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hatli-card {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    padding: clamp(1.25rem, 3.5vw, 2.5rem);
    box-shadow: var(--shadow-lg);
  }

  .hatli-card-header {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hatli-brand-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .hatli-logo-wrapper {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    flex-shrink: 0;
  }

  .hatli-logo-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .dot-live {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--accent);
    box-shadow: 0 0 6px var(--accent);
  }

  .hatli-main-title {
    font-size: clamp(1.6rem, 3.2vw, 2.25rem);
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .ar-title {
    font-weight: 600;
    color: var(--text-muted);
  }

  .hatli-summary-text {
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 860px;
  }

  .hatli-action-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hatli-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding-top: 0.25rem;
  }

  /* Visual Stage */
  .hatli-visual-stage {
    margin-top: 2rem;
    margin-bottom: 2rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
  }

  .mockup-frame {
    width: 100%;
    overflow: hidden;
    background-color: #000;
  }

  .mockup-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    transition: transform var(--transition-smooth);
  }

  .mockup-frame:hover .mockup-img {
    transform: scale(1.015);
  }

  .mockup-caption-bar {
    padding: 0.875rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    background-color: var(--bg-surface-elevated);
    border-top: 1px solid var(--border-subtle);
  }

  @media (min-width: 640px) {
    .mockup-caption-bar {
      flex-direction: row;
      align-items: center;
      gap: 0.875rem;
    }
  }

  .caption-tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-xs);
    background-color: var(--accent-light);
    border: 1px solid var(--accent-border);
    white-space: nowrap;
    width: fit-content;
  }

  .caption-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Problem vs Solution */
  .problem-solution-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  @media (min-width: 768px) {
    .problem-solution-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .ps-card {
    padding: 1.35rem;
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .problem-card {
    background-color: var(--bg-surface-elevated);
    border: 1px solid rgba(239, 68, 68, 0.25);
  }

  .solution-card {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--accent-border);
  }

  .ps-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .ps-icon {
    font-size: 1.125rem;
  }

  .ps-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .ps-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Architectural Highlights Grid */
  .highlights-container {
    background-color: var(--bg-surface-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .highlights-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .highlights-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .highlights-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--accent);
    padding: 0.15rem 0.5rem;
    background-color: var(--accent-light);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-full);
  }

  .highlights-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .highlights-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .highlight-item-card {
    padding: 1.25rem;
    background-color: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all var(--transition-fast);
  }

  .highlight-item-card:hover {
    border-color: var(--border-medium);
  }

  .item-card-top {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .item-num {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .item-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .item-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .item-desc {
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .item-impact {
    margin-top: auto;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-xs);
    background-color: var(--bg-surface-elevated);
    border-left: 3px solid var(--accent);
  }

  .impact-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--accent);
    display: block;
    margin-bottom: 0.2rem;
  }

  .impact-text {
    font-size: 0.8125rem;
    color: var(--text-primary);
    line-height: 1.45;
  }

  /* Footer Action Banner */
  .hatli-footer-banner {
    margin-top: 2rem;
    padding: 1.5rem 1.75rem;
    background: linear-gradient(135deg, var(--bg-surface-elevated), var(--bg-surface));
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .hatli-footer-banner {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .banner-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .banner-sub {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }
</style>
