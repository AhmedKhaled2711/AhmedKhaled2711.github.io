---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Page Not Found | Ahmed Khaled"
  description="The requested page could not be found. Return to Ahmed Khaled's Android Engineering portfolio."
>
  <div class="error-container">
    <div class="container">
      <div class="error-card">
        <div class="error-badge">
          <span class="badge-dot" aria-hidden="true"></span>
          <span>HTTP 404 • Activity Not Found</span>
        </div>

        <div class="logcat-mock">
          <div class="logcat-header">
            <span class="terminal-dot red" aria-hidden="true"></span>
            <span class="terminal-dot yellow" aria-hidden="true"></span>
            <span class="terminal-dot green" aria-hidden="true"></span>
            <span class="logcat-title">Logcat :: Android Navigation Graph</span>
          </div>
          <code class="logcat-code">
            <span class="log-tag">E/NavHost:</span> Destination route not mapped in NavGraph.<br />
            <span class="log-trace">&nbsp;&nbsp;at androidx.navigation.NavController.navigate(NavController.kt:404)</span><br />
            <span class="log-trace">&nbsp;&nbsp;at com.ahmedkhaled.portfolio.ui.MainNavigation.handle(Route.kt:1)</span>
          </code>
        </div>

        <h1 class="error-title">Page Not Found</h1>
        <p class="error-description">
          The destination you requested does not exist in this navigation graph, was moved, or had its route updated.
        </p>

        <div class="error-actions">
          <a href="/" class="btn btn-primary">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            <span>Return to Portfolio</span>
          </a>
          <a href="/projects/hatli" class="btn btn-secondary">
            <span>Explore Hatli Case Study</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .error-container {
    min-height: calc(100vh - 160px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) 0;
  }

  .error-card {
    max-width: 640px;
    margin: 0 auto;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background-color: rgba(239, 68, 68, 0.1);
    color: #ef4444;
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: 9999px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 600;
    margin-bottom: var(--space-6);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #ef4444;
  }

  .logcat-mock {
    width: 100%;
    background-color: var(--code-bg);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    margin-bottom: var(--space-6);
    text-align: left;
  }

  .logcat-header {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    background-color: rgba(0, 0, 0, 0.2);
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }

  .terminal-dot.red { background-color: #ef4444; }
  .terminal-dot.yellow { background-color: #f59e0b; }
  .terminal-dot.green { background-color: #10b981; }

  .logcat-title {
    margin-left: 0.5rem;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
  }

  .logcat-code {
    display: block;
    padding: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.6;
    color: var(--text-secondary);
    overflow-x: auto;
  }

  .log-tag {
    color: #ef4444;
    font-weight: 700;
  }

  .log-trace {
    color: var(--text-tertiary);
  }

  .error-title {
    font-size: clamp(var(--text-2xl), 4vw, var(--text-4xl));
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
  }

  .error-description {
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-8);
    max-width: 480px;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }
</style>
